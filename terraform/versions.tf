terraform {
  required_version = ">= 1.6"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}

provider "aws" {
  region = var.aws_region

  # Automatically added to every resource
  default_tags {
    tags = {
      Project = "argus"
    }
  }
}
